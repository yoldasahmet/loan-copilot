# Postgres connection (Docker Compose publishes the db on port 5433)
DATABASE_URL=postgresql+psycopg://loancopilot:loancopilot@localhost:5433/loancopilot
# Where uploaded files are stored
DATA_DIR=./.data
# Secret used to sign session cookies — set a long random string
SESSION_SECRET=change-me-to-a-long-random-string
# LLM provider: auto (first key that is set), anthropic, openai or openrouter
LLM_PROVIDER=auto
# Anthropic API key (Claude)
ANTHROPIC_API_KEY=
# OpenAI API key
OPENAI_API_KEY=
# OpenRouter API key (any model on openrouter.ai)
OPENROUTER_API_KEY=
# Model for every LLM call; use the provider's id (OpenRouter: provider/model)
LLM_MODEL=claude-opus-5-5
# Price per million input tokens in USD for LLM_MODEL (cost tracking only)
LLM_PRICE_INPUT_PER_MTOK=4.00
# Price per million output tokens in USD for LLM_MODEL (cost tracking only)
LLM_PRICE_OUTPUT_PER_MTOK=20.00
# Embeddings backend: local (sentence-transformers) or fake (deterministic hash vectors for tests)
EMBEDDINGS_BACKEND=local
# Embedding model (1024 dimensions)
EMBEDDING_MODEL=BAAI/bge-m3
# Cross-encoder reranking: on or off
RERANK=on
# Reranker model
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Interest rate assumed for the new loan's annuity in the DSCR
ASSUMED_INTEREST_RATE=0.08
# LLM requests allowed per user per minute
RATE_LIMIT_PER_MINUTE=30
# Optional OpenTelemetry collector (Phoenix), e.g. http://localhost:6006/v1/traces — leave empty to disable
PHOENIX_COLLECTOR_ENDPOINT=
# FastAPI base URL used by the Next.js /api rewrite
API_URL=http://localhost:8000
